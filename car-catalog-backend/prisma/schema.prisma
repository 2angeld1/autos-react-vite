// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // 'user' or 'admin'
  avatar    String?
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites Favorite[]
  reviews   Review[]
}

model Car {
  id              String   @id @default(cuid())
  make            String
  model           String
  year            Int
  price           Float
  image           String
  description     String?
  fuel_type       String   // 'gas', 'diesel', 'electricity', 'hybrid'
  transmission    String   // 'a' (automatic) or 'm' (manual)
  cylinders       Int?
  class           String?  @map("className")
  displacement    Float?
  city_mpg        Int?
  highway_mpg     Int?
  combination_mpg Int?
  features        String[]
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  favorites Favorite[]
  reviews   Review[]

  @@index([make, model, year])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  carId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  carId     String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
}
